{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/DataClassification.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/IdentityField.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/ClauseRef.json"
      }
    },
    "level": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/ConfidentialityLevel.json"
    },
    "values": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/EnumValue.json"
      }
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A handling class for data. `operations` and `relations` are forbidden by the seal.",
  "allOf": [
    {
      "properties": {
        "fields": {
          "contains": {
            "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/LevelField.json"
          }
        }
      }
    },
    {
      "properties": {
        "fields": {
          "items": {
            "not": {
              "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/DefaultedField.json"
            }
          }
        }
      }
    }
  ]
}
