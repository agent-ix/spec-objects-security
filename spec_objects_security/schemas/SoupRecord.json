{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/SoupRecord.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/IdentityField.json"
      }
    },
    "purl": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_fact_ref": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
      }
    },
    "inventory_ref": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
    },
    "serves": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
      }
    },
    "known_anomalies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/Anomaly.json"
      }
    },
    "support_status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/SoupSupportStatus.json"
    },
    "end_of_support": {
      "type": "string",
      "pattern": "^(unknown|[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$"
    },
    "disposition_clause": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A reviewed third-party component (SOUP), identified by its purl, which the\ndeclaration states as a `purl` field row. Every value\nis an SBOM-stated fact, a reviewer statement or a pointer to a person-owned\ndisposition; nothing is computed. `license` and `license_fact_ref` are\nmutually exclusive, and `end_of_support` is a calendar date or `unknown`. The\nseal refuses `digest`, finding text, advisory keys and an embedded decision.\n`operations`, `relations` and `clauses` are forbidden by the seal.",
  "allOf": [
    {
      "properties": {
        "fields": {
          "contains": {
            "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/PurlField.json"
          }
        }
      }
    },
    {
      "properties": {
        "fields": {
          "items": {
            "not": {
              "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/DefaultedField.json"
            }
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "license",
          "license_fact_ref"
        ]
      }
    }
  ]
}
