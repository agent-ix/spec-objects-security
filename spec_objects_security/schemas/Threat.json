{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/Threat.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/IdentityField.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/ClauseRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/RelationDecl.json"
      }
    },
    "stride_category": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/StrideCategory.json"
    },
    "exploits": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/SemanticId.json"
      }
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "An adversary capability against this system. `operations` is forbidden by the seal.",
  "allOf": [
    {
      "properties": {
        "fields": {
          "contains": {
            "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/StrideCategoryField.json"
          }
        }
      }
    },
    {
      "properties": {
        "fields": {
          "items": {
            "not": {
              "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/DefaultedField.json"
            }
          }
        }
      }
    }
  ]
}
