{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/OccurrenceTypeRef.json",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "KernelScalar"
        },
        "value": {
          "type": "string",
          "const": "Timestamp"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    }
  },
  "required": [
    "target"
  ],
  "description": "A `TypeRef` whose target is the kernel `Timestamp` scalar."
}
