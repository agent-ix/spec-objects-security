{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/0.2.0/StrideCategory.json",
  "type": "string",
  "enum": [
    "spoofing",
    "tampering",
    "repudiation",
