{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/ScopeExclusion.json",
  "type": "object",
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^[!-.0-?A-~]{1,64}/[!-.0-?A-~]{1,64}@[!-.0-?A-~]{1,64}$"
    },
    "clause": {
      "type": "string",
      "pattern": "^[!-~]{1,64}$"
    },
    "responsible": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
    },
    "rationale": {
      "type": "string",
      "pattern": "\\S"
    },
    "decision": {
      "type": "string",
      "pattern": "^(delegated|accepted_risk|temporary_exception)$"
    },
    "decision_owner": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
    },
    "approval_ref": {
      "type": "string",
      "pattern": "\\S"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "format": "date-time"
    }
  },
  "required": [
    "set",
    "clause",
    "responsible",
    "rationale",
    "decision",
    "decision_owner",
    "approval_ref"
  ],
  "oneOf": [
    {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/ScopeExclusionDelegated.json"
    },
    {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/ScopeExclusionAcceptedRisk.json"
    },
    {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/ScopeExclusionTemporaryException.json"
    },
    {
      "type": "object",
      "properties": {
        "set": {
          "type": "string",
          "pattern": "^[!-.0-?A-~]{1,64}/[!-.0-?A-~]{1,64}@[!-.0-?A-~]{1,64}$"
        },
        "clause": {
          "type": "string",
          "pattern": "^[!-~]{1,64}$"
        },
        "responsible": {
          "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
        },
        "rationale": {
          "type": "string",
          "pattern": "\\S"
        },
        "decision": {
          "type": "string",
          "not": {
            "enum": [
              "delegated",
              "accepted_risk",
              "temporary_exception"
            ]
          }
        },
        "decision_owner": {
          "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
        },
        "approval_ref": {
          "type": "string",
          "pattern": "\\S"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "format": "date-time"
        }
      },
      "required": [
        "set",
        "clause",
        "responsible",
        "rationale",
        "decision",
        "decision_owner",
        "approval_ref"
      ]
    }
  ],
  "description": "A declaration that one clause is outside the component and records the\nproposed disposition metadata. The disposition and approval reference are\nnot approval; a separate Quoin attestation supplies human authorization."
}
