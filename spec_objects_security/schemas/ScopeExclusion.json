{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-security/ScopeExclusion.json",
  "type": "object",
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^[^/@]{1,64}/[^/@]{1,64}@[^/@]{1,64}$"
    },
    "clause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "responsible": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/SemanticId.json"
    },
    "rationale": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "required": [
    "set",
    "clause",
    "responsible",
    "rationale"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A declaration that one clause of a clause set is outside the component, with\nthe party responsible for it. It is a boundary statement and never an\napproval: it admits no decision, status or approval property."
}
